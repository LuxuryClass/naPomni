FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY backend/global.json backend/Directory.Build.props backend/Directory.Packages.props ./
COPY backend/src/Reminders.Core/Reminders.Core.csproj src/Reminders.Core/
COPY backend/src/Reminders.Worker/Reminders.Worker.csproj src/Reminders.Worker/
RUN dotnet restore src/Reminders.Worker/Reminders.Worker.csproj

COPY backend/src/ src/
RUN dotnet publish src/Reminders.Worker/Reminders.Worker.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app
COPY --from=build /app .
USER $APP_UID
ENTRYPOINT ["dotnet", "Reminders.Worker.dll"]

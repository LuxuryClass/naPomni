<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Интеграционные тесты Api: настоящий HTTP-конвейер (WebApplicationFactory) + настоящий PostgreSQL
    в Docker (Testcontainers). Регистрация/вход, роли в команде, приглашения, xmin-конфликт при правке.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reminders.Api\Reminders.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- WebApplicationFactory<Program> — поднимает Api в памяти -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Настоящий PostgreSQL: xmin, уникальные индексы, каскады не проверить на InMemory/SQLite -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
